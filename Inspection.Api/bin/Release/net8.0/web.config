<?xml version="1.0" encoding="utf-8"?>
<configuration>


	<system.serviceModel>
		<bindings>
			<wsHttpBinding>
				<binding name="WSHttpBinding_IService1">
					<security mode="Transport">
						<transport clientCredentialType="Windows" />
					</security>
				</binding>
			</wsHttpBinding>
		</bindings>
	
	</system.serviceModel>
		
</configuration>