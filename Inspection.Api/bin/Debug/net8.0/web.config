	<system.serviceModel>
		<bindings>
			<wsHttpBinding>
				<binding name="WSHttpBinding_IService1">
					<security mode="Transport">
						<transport clientCredentialType="Windows" />
					</security>
				</binding>
			</wsHttpBinding>
		</bindings>
		<client>
			<endpoint address="http://pcmsv2.pidec.com/MissionWebService.asmx"
					  binding="wsHttpBinding"
					  contract="TestMissionService.MissionWebServiceSoap"
					  name="WSHttpBinding_IService1" />
		</client>
	</system.serviceModel>
		
